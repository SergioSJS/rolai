# Backend
POSTGRES_PASSWORD=changeme
# Origens permitidas (CORS e checagem de Origin do WebSocket). JSON, nunca "*"
# (o pydantic-settings parseia list como JSON — mantenha o formato abaixo).
CORS_ORIGINS=["http://localhost:5273"]
# Producao (frontend estatico em rolai.app):
#CORS_ORIGINS=["https://rolai.app"]
# true SOMENTE com proxy na frente (Traefik). Sem proxy, X-Forwarded-For e
# forjavel e o limite por IP deixa de valer. Ver docs/security.md.
TRUST_PROXY_HEADERS=false

# Limites de abuso — todos opcionais (defaults em services/backend/app/config.py).
# 0 desliga o limite correspondente.
#HTTP_RATE_LIMIT_PER_MINUTE=120
#ROOM_CREATE_LIMIT_PER_HOUR=30
#PROFILE_CREATE_LIMIT_PER_HOUR=10
#WS_CONNECT_LIMIT_PER_MINUTE=30
#MAX_MEMBERS_PER_ROOM=20
#MAX_SPECTATORS_PER_ROOM=5
#RATE_LIMIT_PER_MINUTE=60
#MAX_BODY_BYTES=65536
# GET /stats: vazio = aberto (so agregados). Com valor, exige
# "Authorization: Bearer <token>".
#STATS_TOKEN=
# Teto GLOBAL de salas ativas — POST /rooms devolve 503 acima disso ate
# alguma sala expirar (docs/security.md).
#MAX_ACTIVE_ROOMS=1000
# Profile custom e efemero: expurgo remove os mais velhos que N dias, numa
# task que roda no boot e a cada PROFILE_PURGE_INTERVAL_SECONDS.
#PROFILE_TTL_DAYS=30
#PROFILE_PURGE_INTERVAL_SECONDS=86400

# Hostinger / Traefik (ver infra/docker-compose.hostinger.yml)
# Nao ha TRAEFIK_NETWORK: o Traefik do VPS roda em rede host e alcanca os
# containers pelo IP de bridge — cada app fica na propria rede default.
ROLAI_WEB_HOST=rolai.app
ROLAI_BACKEND_HOST=api.rolai.app
LETSENCRYPT_RESOLVER=letsencrypt
# Versao das imagens do GHCR: latest segue o main, ou fixe uma tag (v0.1.0).
ROLAI_TAG=latest

# Frontend em RUNTIME (container web). A imagem e a mesma pra qualquer
# dominio: isto e lido no start e escrito em /config.js — trocar de dominio
# e trocar isto e reiniciar, sem rebuild (ver apps/web/src/config.ts).
ROLAI_WS_URL=wss://api.rolai.app
# Opcional: base HTTP do backend. Se ausente, o app deriva do WS trocando o
# scheme (wss:// -> https://).
#ROLAI_API_URL=https://api.rolai.app

# Frontend em BUILD — vale so pro `npm run dev` e build local; na imagem
# quem manda e ROLAI_WS_URL acima.
VITE_WS_URL=ws://localhost:8420
#VITE_API_URL=http://localhost:8420
